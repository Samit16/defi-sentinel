# DeFiSentinel Environment Configuration
# MODE: 'local' (default, uses in-memory EVM mocks) or 'fork' (forks mainnet/testnet RPC)
MODE=local

# RPC URL: required only when MODE=fork (e.g. Infura, Alchemy, or public RPC)
RPC_URL=

# FORK_BLOCK: optional specific block number to fork from (leave blank for latest)
FORK_BLOCK=
